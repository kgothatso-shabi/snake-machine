{
  "name": "snake-machine",
  "productName": "Snake II",
  "version": "1.0.2",
  "description": "A remake of the classic Snake II Nokia 3310 game",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/flplima/snake-machine"
  },
  "author": {
    "name": "The Native Black"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "npm run build && electron .",
    "desktop:dev": "cross-env SNAKE_DEV_URL=http://localhost:3000 electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "xstate": "^4.38.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "build": {
    "appId": "com.snakemachine.snake2",
    "productName": "Snake II",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "The Native Black"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "copyright": "Copyright © 2026 The Native Black"
  }
}
